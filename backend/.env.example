PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.vercel.app

JIOSAAVN_API_URL=https://notify-music-api.vercel.app
JAMENDO_API_URL=https://api.jamendo.com/v3.0
JAMENDO_CLIENT_ID=2fa42d8a

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ebf1wte.mongodb.net/notify_music_player?retryWrites=true&w=majority
MONGODB_DB_NAME=notify_music_player

# JWT & Cookie Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_key
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret
# Cookie security is decoupled from NODE_ENV. For a cross-origin HTTPS
# production frontend (soundrift.tech <-> onrender.com) set:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Google OAuth (authorization-code flow). Set all values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# AI discovery (backend only — never expose this key to Vite/React)
GROQ_API_KEY=
GROQ_DISCOVERY_MODEL=openai/gpt-oss-20b
DISCOVERY_TIMEZONE=Asia/Kolkata
DISCOVERY_REFRESH_CRONS=0 3 * * *|35 12 * * *
DISCOVERY_SECTION_SIZE=12
DISCOVERY_SNAPSHOT_TTL_HOURS=26
DISCOVERY_MATCH_THRESHOLD=0.72
DISCOVERY_SECTION_INTERVAL_MINUTES=5
DISCOVERY_REFRESH_ON_STARTUP=true

# Cloudinary Avatar Configuration
CLOUDINARY_CLOUD_NAME=akjtj9a8
CLOUDINARY_API_KEY=246473713748162
CLOUDINARY_API_SECRET=KyDsVGeClNjzd4I3QI9ticzHvHU
