PORT=5000
NODE_ENV=production

JIOSAAVN_API_URL=https://notify-music-api.vercel.app
JAMENDO_API_URL=https://api.jamendo.com/v3.0
JAMENDO_CLIENT_ID=your_jamendo_client_id
# REQUEST_TIMEOUT_MS=8000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/notify_music_player?retryWrites=true&w=majority
MONGODB_DB_NAME=notify_music_player

# JWT & Cookie Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_key
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret
# Cookie security is decoupled from NODE_ENV. For a cross-origin HTTPS
# production frontend (soundrift.tech <-> onrender.com) set:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# CORS: comma-separated list of allowed frontend origins (defaults to the local dev and production origins)
# ALLOWED_ORIGINS=http://localhost:5173,https://www.soundrift.tech

# Google OAuth (authorization-code flow). Set all values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Brevo transactional email (verification and password-reset codes)
BREVO_API_KEY=
EMAIL_FROM=contactsoundrift@gmail.com
EMAIL_FROM_NAME=Soundrift

# Cloudinary Avatar Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI curation via Groq (backend only — never expose these keys to Vite/React).
# Up to six keys are rotated; GROQ_API_KEY_<n> is also accepted, and GROQ_API_KEY is a legacy single-key fallback.
GROQ_API_1=
GROQ_API_2=
GROQ_API_3=
GROQ_API_4=
GROQ_API_5=
GROQ_API_6=
GROQ_CURATION_MODEL=openai/gpt-oss-120b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_REQUEST_TIMEOUT_MS=45000

# Editorial + web discovery for Trending and Fresh Releases (backend only).
TAVILY_API_KEY=
# TAVILY_CURATION_ENABLED=true
# Monthly ceiling for this application's basic search attempts, including retries.
# Keep paid overages disabled in Tavily; other applications using the key have their own usage.
# TAVILY_MONTHLY_SEARCH_LIMIT=800
# TAVILY_REQUEST_TIMEOUT_MS=20000
# Comma-separated trusted source domains; defaults are defined in liveCurationConfig.ts.
# TAVILY_CURATION_DOMAINS=jiosaavn.com,rollingstoneindia.com,radioandmusic.com,indianexpress.com,hindustantimes.com,timesofindia.indiatimes.com,bollywoodhungama.com,saregama.com,yrf.com
# Ordered pinned playlist IDs: later entries fill shortages or replace a failed primary.
# CURATION_TRENDING_PLAYLIST_IDS=47599074
# CURATION_FRESH_PLAYLIST_IDS=6689255,1210453303
# CURATION_FRESH_MAX_AGE_DAYS=30

# Curation scheduler
CURATION_SCHEDULER_ENABLED=true
CURATION_BACKFILL_ON_STARTUP=true
# CURATION_TIMEZONE=Asia/Kolkata
# CURATION_CYCLE_TIMES=03:00
# CURATION_SECTION_INTERVAL_MINUTES=5
# CURATION_MATCH_THRESHOLD=0.55
# CURATION_KEY_COOLDOWN_MS=90000
# CURATION_KEY_AUTH_COOLDOWN_MS=3600000
# CURATION_SECTION_CACHE_TTL_MS=60000
# CURATION_STARTUP_DELAY_MS=20000
# CURATION_STARTUP_SPACING_MS=15000
# CURATION_RETRY_AFTER_FAILURE_MS=1800000
# CURATION_SECTION_REFRESH_LOCK_MS=900000

# Optional tuning: rate limits and caches
# RATE_LIMIT_SEARCH_WINDOW_MS=60000
# RATE_LIMIT_SEARCH_MAX=300
# RATE_LIMIT_METADATA_WINDOW_MS=60000
# RATE_LIMIT_METADATA_MAX=600
# SLOW_DOWN_SEARCH_DELAY_AFTER=100
# SLOW_DOWN_SEARCH_DELAY_MS=500
# CACHE_TTL_MS=300000
# MUSIC_SEARCH_CACHE_TTL_MS=300000
# MUSIC_METADATA_CACHE_TTL_MS=900000
# MUSIC_TRENDING_CACHE_TTL_MS=45000
# MUSIC_RETRY_DELAY_MS=250
