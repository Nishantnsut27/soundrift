# Production backend URL used by default when VITE_API_URL is not set
VITE_API_URL=https://api.soundrift.tech

# Sentry error monitoring. Copy the React project's DSN from Sentry Client Keys.
# Reporting starts when the DSN is set; restart Vite after changing these values.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Optional release override; Vercel builds use VERCEL_GIT_COMMIT_SHA automatically.
VITE_SENTRY_RELEASE=
# Defaults: 1 in development, 0.1 in production.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional production source-map uploads (build-time settings).
SENTRY_ORG=nishant-or
SENTRY_PROJECT=soundrift-frontend
SENTRY_AUTH_TOKEN=
